# Writes the trust table that is built into piero-syntax.dll (DR-DRAFT-033):
# the SHA-256 of the built parser.dll and of the manifest.toml and
# highlights.scm that ship with it, for every official grammar. Run in script
# mode:  cmake -DOUT=... -DBIN=... -DPACK=... -DIDS="a;b" -P gen_syntax_trust.cmake
set(body "")
set(count 0)
foreach(id IN LISTS IDS)
  file(SHA256 "${BIN}/grammars/${id}/parser.dll" dll)
  file(SHA256 "${PACK}/${id}/highlights.scm" query)
  file(SHA256 "${PACK}/${id}/manifest.toml" manifest)
  string(APPEND body "\t{\"${id}\", \"${dll}\", \"${query}\", \"${manifest}\"},\n")
  math(EXPR count "${count} + 1")
endforeach()
file(WRITE "${OUT}.tmp"
  "/* generated by cmake/gen_syntax_trust.cmake: do not edit */\n"
  "#ifndef WF_SYNTAX_TRUST_H\n#define WF_SYNTAX_TRUST_H\n"
  "#include \"wf_syncore.h\"\n"
  "static const WfSynTrust WF_SYN_TRUST[] = {\n${body}};\n"
  "#define WF_SYN_TRUST_COUNT ${count}u\n#endif\n")
# only touch the header when it changed, so nothing rebuilds for nothing
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}"
  RESULT_VARIABLE copied)
if(NOT copied STREQUAL "0")
  message(FATAL_ERROR "Cannot install the syntax grammar trust header")
endif()
file(REMOVE "${OUT}.tmp")
