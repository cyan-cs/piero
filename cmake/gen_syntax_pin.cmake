# Writes the pin of piero-syntax.dll that is built into piero.exe (DR-DRAFT-033,
# section 4): the SHA-256 of the DLL that was built beside it.
#   cmake -DOUT=... -DDLL=... -P gen_syntax_pin.cmake
file(SHA256 "${DLL}" sha)
file(WRITE "${OUT}.tmp"
  "/* generated by cmake/gen_syntax_pin.cmake: do not edit */\n"
  "#ifndef WF_SYNTAX_PIN_H\n#define WF_SYNTAX_PIN_H\n"
  "#define WF_SYNTAX_DLL_SHA256 \"${sha}\"\n#endif\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}"
  RESULT_VARIABLE copied)
if(NOT copied STREQUAL "0")
  message(FATAL_ERROR "Cannot install the syntax DLL pin header")
endif()
file(REMOVE "${OUT}.tmp")
