# Build-owned, development-only files. No install, PATH or system changes.
if(NOT EXISTS "${RUNTIME}" OR NOT EXISTS "${ASSEMBLY}" OR NOT OUTPUT)
  message(FATAL_ERROR "Incomplete selected sanitizer runtime inputs")
endif()
get_filename_component(runtime_name "${RUNTIME}" NAME)
set(directory "${OUTPUT}/piero.asan.runtime")
file(MAKE_DIRECTORY "${directory}")
configure_file("${RUNTIME}" "${directory}/${runtime_name}" COPYONLY)
configure_file("${ASSEMBLY}" "${directory}/piero.asan.runtime.manifest" COPYONLY)
file(SHA256 "${RUNTIME}" expected)
file(SHA256 "${directory}/${runtime_name}" actual)
if(NOT expected STREQUAL actual)
  message(FATAL_ERROR "Staged sanitizer runtime differs from selected compiler")
endif()
