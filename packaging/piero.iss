; Compile only against the audited stage generated by tools/package_windows.py.
#ifndef PackageDir
  #error PackageDir must identify the prepared payload directory
#endif
#ifndef PieroVersion
  #error PieroVersion is required
#endif
#ifndef OutputPath
  #error OutputPath is required
#endif
[Setup]
AppId={{B7B46C82-F7C6-49B5-83BB-CE2C9A6C902D}
AppName=piero
AppVersion={#PieroVersion}
AppPublisher=cyan-cs
AppPublisherURL=https://github.com/cyan-cs/piero
DefaultDirName={localappdata}\Programs\piero
DefaultGroupName=piero
PrivilegesRequired=lowest
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.22000
DisableProgramGroupPage=yes
ChangesEnvironment=yes
LicenseFile={#PackageDir}\LICENSE
OutputDir={#OutputPath}
OutputBaseFilename=piero-Setup-x64
Compression=lzma2
SolidCompression=yes
CloseApplications=no
RestartApplications=no
UninstallDisplayIcon={app}\piero.exe
[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "japanese"; MessagesFile: "compiler:Languages\Japanese.isl"
[CustomMessages]
english.AddPath=Add piero to your user PATH (new terminals)
japanese.AddPath=pieroをユーザーPATHに追加する（新しい端末から有効）
english.PathFailed=PATH was left unchanged. Install completed; start piero from the Start Menu or review your user PATH manually.
japanese.PathFailed=PATHは変更していません。インストールは完了しました。スタートメニューから起動するか、ユーザーPATHを手動で確認してください。
english.PathChanged=PATH could not be safely restored and was left unchanged. Review the piero entry in your user PATH manually.
japanese.PathChanged=PATHを安全に復元できなかったため変更していません。ユーザーPATHのpieroの項目を手動で確認してください。
english.EmptyDirectory=Choose an empty install directory and uninstall any earlier piero installation first. Existing files will not be overwritten.
japanese.EmptyDirectory=空のインストール先を選び、旧pieroがあれば先にアンインストールしてください。既存ファイルは上書きしません。
[Tasks]
Name: "addtopath"; Description: "{cm:AddPath}"; Flags: unchecked
[Files]
Source: "{#PackageDir}\piero.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#PackageDir}\piero-path.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#PackageDir}\LICENSE"; DestDir: "{app}"; Flags: ignoreversion
Source: "{#PackageDir}\LICENSES\*.txt"; DestDir: "{app}\LICENSES"; Flags: ignoreversion
Source: "{#PackageDir}\languages\*.ini"; DestDir: "{app}\languages"; Flags: ignoreversion
[Icons]
Name: "{userprograms}\piero"; Filename: "{app}\piero.exe"; WorkingDir: "{userprofile}"
[Code]
function PrepareToInstall(var NeedsRestart: Boolean): String;
var Entry: TFindRec;
begin
  Result := '';
  if RegKeyExists(HKCU, 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{B7B46C82-F7C6-49B5-83BB-CE2C9A6C902D}_is1') then
    Result := ExpandConstant('{cm:EmptyDirectory}');
  if (Result = '') and DirExists(ExpandConstant('{app}')) then
    if FindFirst(AddBackslash(ExpandConstant('{app}')) + '*', Entry) then begin
      try
        repeat
          if (Entry.Name <> '.') and (Entry.Name <> '..') then
            Result := ExpandConstant('{cm:EmptyDirectory}');
        until not FindNext(Entry);
      finally
        FindClose(Entry);
      end;
    end else
      Result := ExpandConstant('{cm:EmptyDirectory}');
end;
procedure CurStepChanged(CurStep: TSetupStep);
var Code: Integer;
begin
  Code := -1;
  if (CurStep = ssPostInstall) and WizardIsTaskSelected('addtopath') then
    if not Exec(ExpandConstant('{app}\piero-path.exe'), '--add', '', SW_HIDE, ewWaitUntilTerminated, Code) or (Code <> 0) then
      MsgBox(ExpandConstant('{cm:PathFailed}'), mbInformation, MB_OK);
end;
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var Code: Integer;
begin
  Code := -1;
  if CurUninstallStep = usUninstall then
    if not Exec(ExpandConstant('{app}\piero-path.exe'), '--remove', '', SW_HIDE, ewWaitUntilTerminated, Code) or (Code <> 0) then
      MsgBox(ExpandConstant('{cm:PathChanged}'), mbInformation, MB_OK);
end;
