execute_process(COMMAND "${PROGRAM}" "${MODE}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
if(result STREQUAL "0" OR result MATCHES "[Tt]imeout")
  message(FATAL_ERROR "Deliberate sanitizer fault was not detected")
endif()
if(MODE STREQUAL "asan")
  set(expected "AddressSanitizer: heap-buffer-overflow")
elseif(MODE STREQUAL "asan_global")
  set(expected "AddressSanitizer: global-buffer-overflow")
else()
  set(expected "runtime error: signed integer overflow")
endif()
if(NOT "${output}${error}" MATCHES "${expected}")
  message(FATAL_ERROR "Missing expected sanitizer diagnosis: ${output}${error}")
endif()
